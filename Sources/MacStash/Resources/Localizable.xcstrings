            "state": "translated",
            "value": "Vòng quay sẽ không bao giờ kích hoạt khi các ứng dụng này đang hoạt động:"
          }
        }
      }
    },
    "corners.hitZoneHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaller values require moving closer to the extreme edge, preventing accidental triggers."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị nhỏ hơn yêu cầu rê chuột sát rìa mép ngoài hơn, giúp chống chạm nhầm."
          }
        }
      }
    },
