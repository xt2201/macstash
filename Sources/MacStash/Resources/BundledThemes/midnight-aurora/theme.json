{
  "schemaVersion": 1,
  "id": "midnight-aurora",
  "name": "Midnight Aurora",
  "author": "MacStash",
  "version": "1.0.0",
  "description": "Deep indigo and violet translucent glass inspired by the Northern Lights.",
  "appearance": {
    "disablesGlassLook": false,
    "tile": {
      "clipShape": "rounded",
      "spacing": 6,
      "verticalPadding": 6
    },
    "window": {
      "clipShape": "rounded",
      "cornerRadius": 18,
      "tintOpacity": 0.25,
      "tintColor": { "r": 0.1, "g": 0.05, "b": 0.25 },
      "borderWidth": 1,
      "borderColor": { "r": 0.6, "g": 0.4, "b": 1, "opacity": 0.3 }
    },
    "indicators": {
      "shape": "dot",
      "color": { "r": 0.7, "g": 0.4, "b": 1 },
      "scale": 1.0,
      "offset": -4
    }
  }
}