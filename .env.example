# MacStash Build & Code Signing Environment Configuration Example
# Copy to .env and adjust values for production release signing.

# Apple Developer ID Application Signing Identity
# Example: "Developer ID Application: Your Name (XXXXXXXXXX)"
# Leave empty for ad-hoc signing during local testing
SIGNING_IDENTITY=""

# Apple Developer Team ID
DEVELOPMENT_TEAM=""

# Notarytool Keychain Credentials Profile
NOTARIZATION_KEYCHAIN_PROFILE=""
